{
  "name": "roulette",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && node scripts/build-server.js",
    "start": "node dist-server/index.js",
    "lint": "biome check --fix src/ server/ shared/",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "determinism": "tsx scripts/determinism.ts",
    "test:server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "box2d-wasm": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
